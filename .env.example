# Todo corre local. No hace falta ninguna llave de API.
OLLAMA_BASE_URL=http://localhost:11434

# Carpeta del estado local (registro, trazas, índice). Se puede borrar.
# BIA_ESTADO_DIR=.estado

# Fecha "de hoy" para evaluar vigencias (AAAA-MM-DD). Vacío = fecha real.
# BIA_HOY=2026-10-03

# 0 = búsqueda solo BM25 (sin nomic-embed-text)
# BIA_EMBEDDINGS=1

# 0 = apaga el clasificador de alcance del guard de entrada
# BIA_GUARD_ALCANCE=1
